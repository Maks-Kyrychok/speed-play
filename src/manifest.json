{
  "manifest_version": 3,
  "name": "SpeedyPlay",
  "version": "1.1.0",
  "description": "Playback speed control for YouTube.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpeedyPlay",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "speed.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-speed": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle between normal speed and your speed"
    },
    "speed-up": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Speed up by 0.25x"
    },
    "speed-down": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Slow down by 0.25x"
    }
  }
}
